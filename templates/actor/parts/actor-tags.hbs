<div>
  <h3 class="ncou-hacked-font ncou-h3">Tags</h3>
  <ol class="items-list ncou-items-list">
    {{#each tags as |tag|}}
      <li class="item flexrow draggable" data-item-id="{{tag._id}}" data-document-class="Item" data-type="tag">
        <div class="item-name">
          {{#if @root.system.sheet_unlocked}}
            <a
              class="item-control item-edit"
              data-tooltip='{{localize "DOCUMENT.Update" type='Tag'}}'
              data-action='viewDoc'
              data-document-class='Item'
              data-type="tag"
            >{{tag.name}}</a>
          {{else}}
            <div>{{tag.name}}</div>
          {{/if}}
        </div>
      </li>
    {{/each}}
    <li class="flex-group-right item-create">
      {{#if @root.system.sheet_unlocked}}
        <a
          class="item-control item-create"
          data-tooltip="{{localize "DOCUMENT.Create" type="Tag"}}"
          data-action='createDoc'
          data-document-class='Item'
          data-type="tag"
        >
          <i class="fas fa-plus"></i>
        </a>
      {{/if}}
    </li>
  </ol>
</div>