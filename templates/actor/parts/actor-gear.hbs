<div>
  <h3 class="ncou-hacked-font ncou-h3">Gear</h3>
  <ol class="items-list ncou-items-list ncou-gear-list">
    {{#each gear as |gear id|}}
      {{#unless (eq system.tags "")}}
        <li class="flexrow draggable" data-item-id="{{gear._id}}" data-document-class="Item" data-type="gear">
          <div>
          {{#if @root.system.sheet_unlocked}}
              <a
                class="item-control item-edit"
                data-tooltip='{{localize "DOCUMENT.Update" type='Gear'}}'
                data-action='viewDoc'
                data-document-class='Item'
                data-type="gear"
              >{{gear.name}}</a>
            {{else}}
              <div>{{gear.name}}</div>
            {{/if}}
          </div>
        </li>
        <li class="gear-tags">
          <div class="ncou-geartags"><i class="fa-solid fa-tags"></i> {{system.tags}}</div>
        </li>
      {{else}}
        <li class="item flexrow draggable" data-item-id="{{gear._id}}" data-document-class="Item" data-type="gear">
          <div>
            {{#if @root.system.sheet_unlocked}}
              <a
                class="item-control item-edit"
                data-tooltip='{{localize "DOCUMENT.Update" type='Gear'}}'
                data-action='viewDoc'
                data-document-class='Item'
                data-type="gear"
              >{{gear.name}}</a>
            {{else}}
              <div>{{gear.name}}</div>
            {{/if}}
          </div>
        </li>
      {{/unless}}
    {{/each}}
    <li class="flex-group-right">
      {{#if @root.system.sheet_unlocked}}
        <a
          class="item-control item-create"
          data-tooltip="{{localize "DOCUMENT.Create" type="Gear"}}"
          data-action='createDoc'
          data-document-class='Item'
          data-type="gear"
        >
          <i class="fas fa-plus"></i>
        </a>
      {{/if}}
    </li>
  </ol>
</div>
<div class="stash-section">
  <h3 class="ncou-hacked-font ncou-h3">Stash</h3>
  <div class="flexrow">
    <div>&nbsp;
      {{#each system.stash as |stashbox key|}}
        <input class="ncou-check-cyber" type="checkbox" name="system.stash.{{key}}.value" value="{{stashbox.value}}" data-dtype="Boolean" {{checked stashbox.value}}/>&nbsp;
      {{/each}}
    </div>
  </div>
</div>