<div>
  <h3 class="ncou-hacked-font ncou-h3">Trademarks</h3>
  <div class="flex-group-left">
    <ol class="items-list">
      {{#each trademarks as |trademark|}}
         <div class="trademark-section">
          <li class="item flexrow draggable trademark" data-item-id="{{trademark._id}}" data-trademarkid="{{trademark._id}}" data-document-class="Item" data-type="trademark">
            <div class="ncou-cyber">
              {{#if @root.system.sheet_unlocked}}
                <a
                  class="item-control item-edit"
                  data-tooltip='{{localize "DOCUMENT.Update" type='Trademark'}}'
                  data-action='viewDoc'
                  data-document-class='Item'
                  data-type="trademark"
                >
                  <div class="ncou-trademark-header">{{trademark.name}}</div>
                </a>
              {{else}}
                <div class="ncou-trademark-header" data-item-id="{{trademark._id}}">{{trademark.name}}</div>
              {{/if}}
            </div>
          </li>
          <li>
            <ol class="items-list ncou-items-list ncou-edge-list ncou-box-notop">
            {{#each ../edges as |edges trademarkid|}}
              {{#if (eq trademarkid trademark._id)}}  
                {{#each edges as |edge id|}}
                  <li class="item flexrow draggable" data-item-id="{{edge._id}}" data-document-class="Item" data-type="edge">
                    <div class="ncou-check ncou-edge-checkbox-wrapper">
                      <input class="ncou-check-cyber ncou-edge-checkbox" type="checkbox" data-action="toggleEdge" data-dtype="Boolean" {{checked system.isEdge}}/>
                    </div>
                    <div class="flexrow">
                      {{#if @root.system.sheet_unlocked}}
                        <a
                          class="item-control item-edit"
                          data-tooltip='{{localize "DOCUMENT.Update" type='Edge'}}'
                          data-action='viewDoc'
                          data-document-class='Item'
                          data-type="edge"
                        >{{edge.name}}</a>
                      {{else}}
                        <div>{{edge.name}}</div>
                      {{/if}}
                    </div>
                  </li>
                {{/each}}
              {{/if}}
            {{/each}}
            {{#if @root.system.sheet_unlocked}}
              <li class="flex-group-right item-create">
                <a
                  class="item-control item-create"
                  data-tooltip="{{localize "DOCUMENT.Create" type="Edge"}}"
                  data-action='createDoc'
                  data-document-class='Item'
                  data-type="edge"
                  data-system.trademarkid="{{trademark._id}}"
                >
            <i class="fas fa-plus"></i>
          </a>
              </li>
            {{/if}}
            </ol>
          </li>
        </div>
      {{/each}}
      <li class="flex-group-left">
        {{#if @root.system.sheet_unlocked}}
          <a
            class="item-control item-create"
            data-tooltip="{{localize "DOCUMENT.Create" type="Trademark"}}"
            data-action='createDoc'
            data-document-class='Item'
            data-type="trademark"
          >
            <i class="fas fa-plus"></i>
          </a>
        {{/if}}
      </li>
    </ol>
  </div>
</div>
