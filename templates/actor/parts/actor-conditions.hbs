<div class="condition-section">
  <h3 class="ncou-hacked-font ncou-h3">Conditions</h3>
  {{#if (eq actor.type "character")}}
  <div class="ncou-grid ncou-grid-3col">
  {{else}}
  <div class="flexcol">
  {{/if}}
    {{#each system.conditions as |condition key|}}
      {{#if (eq condition.modify false)}}
        <div class="ncou-check">
          <input class="ncou-check-cyber" type="checkbox" name="system.conditions.{{key}}.active" value="{{condition.active}}" data-dtype="Boolean" {{checked condition.active}}/> {{condition.name}}
        </div>
      {{else}}
        <div class="ncou-check">
          {{#if @root.system.sheet_unlocked}}
            <input class="ncou-check-cyber" type="checkbox" name="system.conditions.{{key}}.active" value="{{condition.active}}" data-dtype="Boolean" {{checked condition.active}}/> <input class="ncou-input-condition"
          name="system.conditions.{{key}}.name" type="text" value="{{condition.name}}"/>
          {{else}}
            <div class="ncou-bg-shade-transparent"><input class="ncou-check-cyber" type="checkbox" name="system.conditions.{{key}}.active" value="{{condition.active}}" data-dtype="Boolean" {{checked condition.active}}/> {{condition.name}}</div>
          {{/if}}
        </div>
      {{/if}}
    {{/each}}
  </div>
</div>
