<header class="sheet-header">
  <div class="header-fields flexcol">
    <div class="ncou-input-cyber ncou-font-big">
      <input name="name" type="text" value="{{item.name}}" placeholder="Name" />
    </div>
    <div>&nbsp;</div>
    <div class="resource">
      <label class="resource-label ncou-text-primary">Is Edge</label>
    </div>
    <div class="ncou-input-cyber-small">
      <input class="ncou-check-cyber" type="checkbox" name="system.isEdge" value="{{system.isEdge}}" data-dtype="Boolean" {{checked system.isEdge}}/>
    </div>
  </div>
</header>
