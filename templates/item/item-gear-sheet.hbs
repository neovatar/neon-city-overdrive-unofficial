<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <div class="header-fields flexcol">
      <div class="ncou-input-cyber ncou-font-big">
        <input name="name" type="text" value="{{item.name}}" placeholder="Name" />
      </div>
      <div>&nbsp;</div>
      <div class="resource">
        <label class="resource-label ncou-text-primary">Tags</label>
      </div>
      <div class="ncou-input-cyber-small">
        <input type="text" name="system.tags" value="{{system.tags}}" data-dtype="String" />
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs ncou-text-primary" data-group="primary">
    <a class="item" data-tab="description">Description</a>
    <a class="item item-delete" title="{{localize "DOCUMENT.Delete" type="Gear"}}">
      <i class="fas fa-trash ncou-text-primary"></i>
    </a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      {{#if editable}}
        <prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" collaborate="true" toggled="true">
          {{{enrichedDescription}}}
        </prose-mirror>
      {{else}}  {{{enrichedDescription}}}
      {{/if}}
    </div>
  </section>
</form>

{{log system}}